<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MailConverter</AssemblyName>
    <RootNamespace>MailConverter</RootNamespace>
    <Version>1.2.0</Version>
    <Company>MailConverter</Company>
    <Product>小铭邮件百宝箱</Product>
    <Description>多功能邮件转换工具</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="PowerShellModules\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PowerShellModules\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\azcopy.exe" Link="azcopy.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Logs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Logs\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="python\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>python\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <!-- 发布时包含空的Config目录结构 -->
    <Content Include="ConfigTemplate\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Config\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <!-- 发布时包含Bootstrap Icons图标库 -->
    <Content Include="..\..\Icon\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Icon\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Exchange.WebServices.NETStandard" Version="1.1.3" />
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004" />
    <PackageReference Include="MimeKit" Version="4.7.0" />
    <PackageReference Include="MailKit" Version="4.7.0" />
    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="CsvHelper" Version="31.0.0" />
    <PackageReference Include="Microsoft.WindowsAPICodePack-Shell" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Graph" Version="5.57.0" />
    <PackageReference Include="Azure.Identity" Version="1.12.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.19.1" />
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="script\create_pst.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\convert_ost.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\extract_emails.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\check_env.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\deliver_mail.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\ews_deliver.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\graph_deliver.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\generate_key.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\imap_to_msg.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\imap_to_msg_v2.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\extract_emails_to_msg.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\extract_pst_wsl.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\create_pst_2026-03-20_perfect.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\check_ost.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\check_pst.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\generate_readme.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="script\imapToPst_create_pst.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="requirements.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    保护用户运行时配置（特别是 CardDAV 账户信息、OAuth 凭据、IMAP/PST 账户等）
    在 dotnet clean / rm -rf bin obj 时自动备份与恢复 Config/ 目录，
    避免清掉 bin/ 后丢失所有账户配置。
    备份位置: $(ProjectDir).configbackup\ （项目根目录下，不在 bin/obj 里）
  -->
  <PropertyGroup>
    <UserConfigBackupDir>$(ProjectDir).configbackup</UserConfigBackupDir>
  </PropertyGroup>

  <Target Name="PreserveUserConfig" BeforeTargets="Clean">
    <ItemGroup>
      <_UserConfigFilesToPreserve Include="$(OutDir)Config\**\*.*" />
    </ItemGroup>
    <Message Text="[PreserveUserConfig] Backing up %(_UserConfigFilesToPreserve.Identity) -> $(UserConfigBackupDir)\%(RecursiveDir)%(Filename)%(Extension)" Importance="High" Condition="'@(_UserConfigFilesToPreserve)' != ''" />
    <Copy SourceFiles="@(_UserConfigFilesToPreserve)"
          DestinationFiles="$(UserConfigBackupDir)\%(RecursiveDir)%(Filename)%(Extension)"
          SkipUnchangedFiles="true"
          Condition="'@(_UserConfigFilesToPreserve)' != ''" />
  </Target>

  <Target Name="RestoreUserConfig" AfterTargets="Clean" BeforeTargets="Build">
    <PropertyGroup>
      <_UserConfigBackupExists Condition="Exists('$(UserConfigBackupDir)')">true</_UserConfigBackupExists>
    </PropertyGroup>
    <ItemGroup Condition="'$(_UserConfigBackupExists)' == 'true'">
      <_UserConfigBackupFiles Include="$(UserConfigBackupDir)\**\*.*" />
    </ItemGroup>
    <Message Text="[RestoreUserConfig] Restoring %(_UserConfigBackupFiles.Identity) -> $(OutDir)Config\%(RecursiveDir)%(Filename)%(Extension)" Importance="High" Condition="'@(_UserConfigBackupFiles)' != ''" />
    <Copy SourceFiles="@(_UserConfigBackupFiles)"
          DestinationFiles="$(OutDir)Config\%(RecursiveDir)%(Filename)%(Extension)"
          SkipUnchangedFiles="true"
          Condition="'@(_UserConfigBackupFiles)' != ''" />
  </Target>

  <Target Name="SyncUserConfigToBackup" AfterTargets="Build">
    <ItemGroup>
      <_UserConfigFilesToSync Include="$(OutDir)Config\**\*.*" />
    </ItemGroup>
    <Message Text="[SyncUserConfigToBackup] Syncing %(_UserConfigFilesToSync.Identity) -> $(UserConfigBackupDir)\%(RecursiveDir)%(Filename)%(Extension)" Importance="High" Condition="'@(_UserConfigFilesToSync)' != ''" />
    <Copy SourceFiles="@(_UserConfigFilesToSync)"
          DestinationFiles="$(UserConfigBackupDir)\%(RecursiveDir)%(Filename)%(Extension)"
          SkipUnchangedFiles="true"
          Condition="'@(_UserConfigFilesToSync)' != ''" />
  </Target>

</Project>
